# MANAGED BY ANSIBLE -- roles/etcd-s3-backup/templates/credentials.j2
# Manual edits are overwritten on the next run. Change the inventory instead.
#
# The B2 application key scoped to veridex-etcd-backup only (listBuckets,
# listFiles, writeFiles -- no deleteFiles). Never the master key.
#
# Quoted: this file is `source`-d as shell by sync-script.sh.j2. B2 issues
# these values itself (no shell metacharacters in practice), but quoting
# costs nothing and means a future key format change can't turn this file
# into something other than two plain assignments.
B2_APPLICATION_KEY_ID="{{ etcd_s3_backup_access_key }}"
B2_APPLICATION_KEY="{{ etcd_s3_backup_secret_key }}"
