---
# Rendered by the argocd-bootstrap role. Root-only, applied, then deleted.
#
# stringData, not data: kubectl base64-encodes these on apply. Hand-encoding
# invites a trailing newline inside the decoded value, which Argo CD sends
# verbatim as the password and GitHub rejects as a bad credential.
apiVersion: v1
kind: Secret
metadata:
  name: {{ argocd_repo_secret_name }}
  namespace: {{ argocd_namespace }}
  labels:
    # Argo CD only reads a Secret as a repository credential if this exact
    # label is present. Without it the Secret is valid, inert, and ignored.
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: {{ argocd_repo_url | to_json }}
  username: {{ argocd_repo_username | to_json }}
  password: {{ argocd_repo_pat | to_json }}
