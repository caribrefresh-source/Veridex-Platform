{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetRoute53ChangeStatus",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    },
    {
      "Sid": "ListRecordsInVeridexZone",
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z01555242T3QOO9FDT59Z"
    },
    {
      "Sid": "ManageDns01TxtRecords",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z01555242T3QOO9FDT59Z",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": ["TXT"],
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "_acme-challenge.veridexeai.com",
            "_acme-challenge.www.veridexeai.com"
          ]
        }
      }
    }
  ]
}
